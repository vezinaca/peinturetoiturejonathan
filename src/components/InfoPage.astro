---
import MainLayout from '../layouts/MainLayout.astro';
import ServicesGrid from './ServicesGrid.astro';
import ProjectsGallery from './ProjectsGallery.astro';
import QuoteContact from './QuoteContact.astro';
import { company, copy, withBase, type Language } from '../data/site';

const { lang, kind } = Astro.props as { lang: Language; kind: 'services' | 'projects' | 'about' | 'contact' | 'privacy' };
const t = copy[lang];
const title = t.pages[kind];
const description = kind === 'privacy' ? t.privacyText : t.heroLead;
---

<MainLayout lang={lang} title={title} description={description}>
  <main id="main" class="info-page">
    <div class="page-banner"><h1>{title}</h1></div>
    {kind === 'services' && <section class="info-section"><ServicesGrid lang={lang} full /></section>}
    {kind === 'projects' && <section class="info-section"><ProjectsGallery lang={lang} full /></section>}
    {kind === 'about' && <section class="about-section about-page-content">
      <div class="about-photo"><img src={withBase('/images/reference/about-full.webp')} alt={lang === 'fr' ? 'Application d’un revêtement sur une toiture' : 'Applying a roof coating'} /></div>
      <div class="about-copy"><h2>{t.aboutTitle}</h2>{t.aboutText.split('\n\n').map((paragraph, index) => <p>{index === 0 ? <strong>{paragraph}</strong> : paragraph}</p>)}<p>{company.name}</p></div>
    </section>}
    {kind === 'contact' && <section class="contact-section"><QuoteContact lang={lang} /></section>}
    {kind === 'privacy' && <section class="privacy-copy">
      <h2>{t.privacyTitle}</h2>
      <p>{t.privacyText} <a href={`mailto:${company.email}`}>{company.email}</a>.</p>
    </section>}
  </main>
</MainLayout>
