---
import { copy, langRoot, withBase, type Language } from '../data/site';
const { lang } = Astro.props as { lang: Language };
const t = copy[lang];
const root = langRoot(lang);
const baseUrl = import.meta.env.BASE_URL;
const currentPath = baseUrl === '/' ? Astro.url.pathname : `/${Astro.url.pathname.slice(baseUrl.length).replace(/^\/+/, '')}`;
const otherPath = lang === 'fr'
  ? (currentPath.startsWith('/fr/') ? currentPath.replace(/^\/fr\//, '/en/') : '/en/')
  : (currentPath.startsWith('/en/') ? currentPath.replace(/^\/en\//, '/fr/') : '/');
const otherRoot = withBase(otherPath);
---

<div class="quote-strip">
  <div class="quote-strip-inner">
    <span>{t.quotePrompt}</span>
    <a href={`${root}#contact`}>{t.contact}</a>
  </div>
</div>
<header class="site-header">
  <a class="brand" href={root} aria-label="Peinture Toiture Jonathan — accueil">
    <img src={withBase('/images/logo-peinture-toiture-jonathan.png')} alt="Peinture Toiture Jonathan" />
  </a>
  <div class="nav-wrap">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
      <span class="visually-hidden">{lang === 'fr' ? 'Ouvrir le menu' : 'Open menu'}</span>
      <span aria-hidden="true" class="hamburger"><i></i><i></i><i></i></span>
    </button>
    <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <ul class="nav-links" id="primary-navigation" data-nav-links>
        <li><a href={`${root}#services`}>{t.nav.services}</a></li>
        <li><a href={`${root}#projects`}>{t.nav.projects}</a></li>
        <li><a href={`${root}#about`}>{t.nav.about}</a></li>
        <li><a href={`${root}#contact`}>{t.nav.contact}</a></li>
        <li><a class="language-link" href={otherRoot} lang={lang === 'fr' ? 'en' : 'fr'}>{t.otherLang}</a></li>
      </ul>
    </nav>
  </div>
</header>
